{
  "name": "lowcode-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @lowcode/playground dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "conformance": "pnpm --filter @lowcode/materials test",
    "verify:browser": "node scripts/browser-checks.mjs",
    "inspect:browser": "node scripts/cdp-inspect.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
